#pragma code_page(65001)
// Windows icon resources of DesktopEditors.exe (generated by CMake from desktopeditors.rc.in).
// package/inno references these icons by position: DefaultIcon "DesktopEditors.exe,N" for every
// ASC.* file type, shortcut IconIndex, protocol handler. Position N = resource 101 + N, so the
// order must stay identical to extras/projicons/version.rc. 101 is also IDI_MAINICON.

101  ICON "@PROJICONS_DIR@/res/icons/desktopeditors.ico"
